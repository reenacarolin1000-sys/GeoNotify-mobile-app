<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="Geofence Management"
        android:textColor="@color/pastel_blue_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateGeofence"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:text="Create New Geofence"
        android:textColor="@color/text_grey"
        android:textSize="18sp"
        app:backgroundTint="@color/pastel_blue_light"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_add"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="24dp"
        app:iconTint="@color/pastel_blue_dark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditGeofence"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:text="Edit Existing Geofence"
        android:textColor="@color/text_grey"
        android:textSize="18sp"
        app:backgroundTint="@color/pastel_blue_light"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="24dp"
        app:iconTint="@color/pastel_blue_dark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteGeofence"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Delete Geofence"
        android:textColor="@color/text_grey"
        android:textSize="18sp"
        app:backgroundTint="@color/pastel_blue_light"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="24dp"
        app:iconTint="@color/pastel_blue_dark" />

</LinearLayout>