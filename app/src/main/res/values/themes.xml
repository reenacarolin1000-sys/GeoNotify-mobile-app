<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GeoNotify" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pastel_bg</item>
        <item name="colorOnPrimaryContainer">@color/text_main</item>
        <item name="android:windowBackground">@color/pastel_bg</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/primary_blue</item>
        <item name="android:navigationBarColor">@color/pastel_bg</item>

        <item name="materialButtonStyle">@style/Widget.GeoNotify.Button</item>
    </style>

    <style name="Theme.GeoNotify" parent="Base.Theme.GeoNotify" />

    <style name="Widget.GeoNotify.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    
    <style name="Theme.GeoNotify.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.GeoNotify.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>